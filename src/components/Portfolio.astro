---
import Activity from './Activity.astro';
import Moments from './Moments.astro';
import '../styles/portfolio.css';
import { projects } from '../data/projects';

interface Props { lang: 'cs' | 'en' }
const { lang } = Astro.props;
const cs = lang === 'cs';
const t = (czech: string, english: string) => cs ? czech : english;
const otherLang = cs ? 'en' : 'cs';
const sections = [
  ['about', t('O mně','About')],
  ['gaming', t('Hraní','Gaming')],
  ['projects', t('Projekty','Projects')],
  ['moments', t('Momenty','Moments')],
  ['connect', t('Kontakt','Connect')],
];
const interests = [
  ['code',t('Programování','Programming')], ['game',t('Hry','Gaming')], ['leaf',t('Příroda','Nature')], ['pulse',t('Zdravotnictví','Healthcare')], ['camera',t('Fotografie','Photography')]
];
const socials = [
  ['GitHub','https://github.com/GameFunns98','GameFunns98'],
  ['Instagram','https://www.instagram.com/vevoda_vaclav/','@vevoda_vaclav'],
  ['Steam','https://steamcommunity.com/id/Gamefunns/','GameFunns'],
  ['Discord','https://discord.com/users/922153911161323601','922153911161323601'],
  ['LinkedIn','https://www.linkedin.com/in/v%C3%A1clav-duda-1956463a8/','Václav Duda'],
];
---
<svg class="gf-symbols" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
  <defs>
    <symbol id="gf-arrow" viewBox="0 0 24 24"><path d="M5 12h14m-6-6 6 6-6 6"/></symbol>
    <symbol id="gf-external" viewBox="0 0 24 24"><path d="M6 18 18 6M7 6h11v11"/></symbol>
    <symbol id="gf-down" viewBox="0 0 24 24"><path d="M12 4v16m-6-6 6 6 6-6"/></symbol>
    <symbol id="gf-sun" viewBox="0 0 24 24"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5"/></symbol>
    <symbol id="gf-moon" viewBox="0 0 24 24"><path d="M20 14A8.5 8.5 0 0 1 10 4a8.5 8.5 0 1 0 10 10Z"/></symbol>
    <symbol id="gf-code" viewBox="0 0 24 24"><path d="m7 7-5 5 5 5m10-10 5 5-5 5M14 4l-4 16"/></symbol>
    <symbol id="gf-game" viewBox="0 0 24 24"><path d="M8 7h8c2 0 3.5 1.4 4 3.4l1 5c.6 3.1-1.5 4.4-3.6 2.5L15 16H9l-2.4 1.9c-2.2 1.9-4.2.6-3.6-2.5l1-5C4.5 8.4 6 7 8 7Z"/><path d="M7 12h4m-2-2v4m6-2h.1m2-2h.1"/></symbol>
    <symbol id="gf-leaf" viewBox="0 0 24 24"><path d="M20 3C9 3 3 7 4 14c.6 4.2 5.8 5.9 9.4 3.6C18.5 14.5 19.8 7.8 20 3ZM3 21l11-12"/></symbol>
    <symbol id="gf-pulse" viewBox="0 0 24 24"><path d="M2 12h5l3-8 4 16 3-8h5"/></symbol>
    <symbol id="gf-camera" viewBox="0 0 24 24"><path d="M3 7h4l2-3h6l2 3h4v13H3z"/><circle cx="12" cy="13" r="3.5"/></symbol>
  </defs>
</svg>
<a class="gf-skip" href="#main-content">{t('Přeskočit na obsah','Skip to content')}</a>
<header class="gf-header" id="top">
  <div class="gf-wrap gf-head-inner">
    <a class="gf-brand" href="#top" aria-label={t('GameFunns – úvod','GameFunns – home')}><span class="gf-monogram" aria-hidden="true">G<span>F</span></span>GameFunns</a>
    <nav class="gf-nav" id="gf-nav" aria-label={t('Hlavní navigace','Main navigation')}>
      {sections.map(([id,label]) => <a href={'#'+id}>{label}</a>)}
    </nav>
    <div class="gf-controls">
      <a class="gf-lang" href={'/'+otherLang+'/'} hreflang={otherLang} data-choose-lang={otherLang} aria-label={t('Switch to English','Přepnout do češtiny')}>{cs?'EN':'CZ'}</a>
      <button class="gf-theme" type="button" data-theme-switch aria-label={t('Přepnout vzhled','Switch theme')} data-dark={t('Zapnout tmavý motiv','Use dark theme')} data-light={t('Zapnout světlý motiv','Use light theme')}>
        <svg class="gf-icon gf-show-dark" aria-hidden="true"><use href="#gf-sun"/></svg><svg class="gf-icon gf-show-light" aria-hidden="true"><use href="#gf-moon"/></svg>
      </button>
      <button class="gf-menu" type="button" aria-controls="gf-nav" aria-expanded="false" aria-label={t('Navigační menu','Navigation menu')}><span></span><span></span></button>
    </div>
  </div>
</header>
<main id="main-content">
  <section class="gf-hero" aria-labelledby="hero-name">
    <div class="gf-landscape" aria-hidden="true"></div>
    <div class="gf-wrap gf-hero-inner">
      <figure class="gf-portrait">
        <div class="gf-portrait-frame"><img src="/images/portrait.webp" alt={t('Portrét Václava','Portrait of Václav')} fetchpriority="high" width="460" height="580"/></div>
        <figcaption>Václav Duda</figcaption>
      </figure>
      <div class="gf-intro">
        <p class="gf-line gf-hello">{t('Ahoj, jsem Václav','Hey, I’m Václav')}</p>
        <h1 id="hero-name">Game<span>Funns</span><i>.</i></h1>
        <p class="gf-lead">{t('Baví mě tvořit věci, které mi chybí. Někdy je to pár řádků kódu, jindy celý herní svět.','I like building the things I wish existed. Sometimes that’s a few lines of code, sometimes a whole game world.')}</p>
        <div class="gf-hero-links">
          <a class="gf-button" href="#projects">{t('Moje projekty','My projects')}<svg class="gf-icon" aria-hidden="true"><use href="#gf-arrow"/></svg></a>
          <a class="gf-secondary" href="#about">{t('Více o mně','More about me')}<svg class="gf-icon" aria-hidden="true"><use href="#gf-down"/></svg></a>
        </div>
      </div>
    </div>
  </section>
  <section class="gf-wrap gf-section gf-about" id="about" aria-labelledby="about-title">
    <div><p class="gf-line">{t('O mně','About me')}</p><h2 id="about-title">{t('Mezi kódem','Between code')}<br/><em>{t('a přírodou.','and nature.')}</em></h2></div>
    <div class="gf-about-body"><p>{t('Studuji zdravotnictví a ve volném čase programuji. Když mě ve hře nebo při práci něco zdržuje, většinou si na to zkusím napsat vlastní nástroj.','I study healthcare and write code in my spare time. When something slows me down in a game or while I’m working, I usually try building a tool for it.')}</p><p>{t('Rád se taky ztratím v přírodě, občas s foťákem v ruce. Tady dávám dohromady projekty, hry a drobné momenty, ke kterým se rád vracím.','I also like wandering outdoors, sometimes with a camera in hand. This is where I keep the projects, games and little moments I come back to.')}</p>
      <ul class="gf-interests">{interests.map(([icon,label])=><li><svg class="gf-icon" aria-hidden="true"><use href={'#gf-'+icon}/></svg>{label}</li>)}</ul>
    </div>
  </section>
  <div class="gf-wrap gf-integration"><Activity lang={lang}/></div>
  <section class="gf-wrap gf-section" id="projects" aria-labelledby="projects-title">
    <div class="gf-section-head"><div><p class="gf-line">GitHub</p><h2 id="projects-title">{t('Vybrané','Selected')} <em>{t('projekty.','projects.')}</em></h2></div><a class="gf-secondary" href="https://github.com/GameFunns98">{t('Profil na GitHubu','GitHub profile')}<svg class="gf-icon" aria-hidden="true"><use href="#gf-external"/></svg></a></div>
    <div class="gf-project-grid">{projects.map(project=><article class="gf-project"><a href={'https://github.com/GameFunns98/'+project.repo}><div class="gf-project-art"><img src={'/images/project-'+project.key+'.svg'} alt="" width="760" height="370" loading="lazy"/></div><div class="gf-project-inner"><div class="gf-project-title"><h3>{project.title[lang]}</h3><svg class="gf-icon" aria-hidden="true"><use href="#gf-external"/></svg></div><p>{project.description[lang]}</p><ul class="gf-tags">{project.tags.map(tag=><li>{tag}</li>)}</ul></div></a></article>)}</div>
  </section>
  <div class="gf-wrap gf-integration"><Moments lang={lang}/></div>
  <section id="connect" class="gf-connect" aria-labelledby="connect-title"><div class="gf-wrap gf-connect-inner"><div><p class="gf-line">{t('Kontakt','Connect')}</p><h2 id="connect-title">{t('Kde mě','Where to')} <em>{t('najdeš.','find me.')}</em></h2></div><ul class="gf-socials">{socials.map(([name,url,handle])=><li><a href={url}><strong>{name}</strong><span>{handle}</span><svg class="gf-icon" aria-hidden="true"><use href="#gf-external"/></svg></a></li>)}</ul></div></section>
</main>
<footer class="gf-wrap gf-footer"><span>© {new Date().getFullYear()} Václav Duda</span><a href="#top">{t('Zpět nahoru','Back to top')} ↑</a></footer>
<script>
  const root = document.documentElement;
  const switcher = document.querySelector<HTMLButtonElement>('[data-theme-switch]');
  function syncThemeLabel() {
    if (switcher) switcher.setAttribute('aria-label', (root.dataset.theme === 'light' ? switcher.dataset.dark : switcher.dataset.light) || '');
  }
  syncThemeLabel();
  switcher?.addEventListener('click', () => {
    const theme = root.dataset.theme === 'light' ? 'dark' : 'light';
    root.dataset.theme = theme;
    try { localStorage.setItem('theme', theme); } catch {}
    syncThemeLabel();
  });
  const langLink = document.querySelector<HTMLAnchorElement>('[data-choose-lang]');
  langLink?.addEventListener('click', () => {
    try { localStorage.setItem('lang', langLink.dataset.chooseLang || 'cs'); } catch {}
    langLink.hash = location.hash;
  });
  const menu = document.querySelector<HTMLButtonElement>('.gf-menu');
  const nav = document.querySelector<HTMLElement>('.gf-nav');
  function toggleMenu(open: boolean) {
    menu?.setAttribute('aria-expanded', String(open));
    nav?.classList.toggle('open', open);
  }
  menu?.addEventListener('click', () => toggleMenu(menu.getAttribute('aria-expanded') !== 'true'));
  nav?.addEventListener('click', () => toggleMenu(false));
  document.addEventListener('keydown', event => {
    if (event.key === 'Escape' && menu?.getAttribute('aria-expanded') === 'true') { toggleMenu(false); menu.focus(); }
  });
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const landscape = document.querySelector<HTMLElement>('.gf-landscape');
    let scheduled = false;
    window.addEventListener('scroll', () => {
      if (scheduled || !landscape) return;
      scheduled = true;
      requestAnimationFrame(() => {
        landscape.style.setProperty('--gf-travel', Math.min(window.scrollY * .08, 38) + 'px');
        scheduled = false;
      });
    }, {passive:true});
  }
</script>
